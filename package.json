{
  "name": "jurycrowd",
  "private": true,
  "description": "Open-source multi-agent workspace manager — run AI coding agents side-by-side in resizable terminal panels.",
  "license": "MIT",
  "homepage": "https://jurycrowd.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/jurycrowd/jurycrowd.git"
  },
  "bugs": {
    "url": "https://github.com/jurycrowd/jurycrowd/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "cline",
    "terminal",
    "tmux",
    "workspace",
    "multi-agent",
    "developer-tools"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel --filter=backend --filter=frontend dev",
    "dev:backend": "pnpm --filter=backend dev",
    "dev:frontend": "pnpm --filter=frontend dev",
    "build": "pnpm -r build",
    "build:cli": "pnpm --filter=jurycrowd build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@11.13.1"
}
